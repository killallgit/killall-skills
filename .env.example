# Copy to .env and fill in. The real .env is gitignored (see .gitignore).
# Consumed by hooks/voice-readback/voice-readback.py (and future hooks).
# A present .env is authoritative: it overrides shell environment variables.

# ElevenLabs API key — https://elevenlabs.io/app/settings/api-keys (starts with sk_).
# Leave blank to use the free OS voice instead (TTMG_TTS=say).
ELEVENLABS_API_KEY=sk_xxx

# TTS provider: elevenlabs (default when a key is set) | say (OS voice, no key)
TTMG_TTS=elevenlabs

# ElevenLabs voice id and model (Sarah + low-latency Flash v2.5 by default).
TTMG_VOICE_ID=EXAVITQu4vr4xnSDxMaL
TTMG_MODEL=eleven_flash_v2_5

# Cap spoken length in characters (0 = no cap).
TTMG_MAX_CHARS=1500

# Fall back to the OS voice if an ElevenLabs call fails (1 = yes, 0 = no).
TTMG_FALLBACK_SAY=1
