          "name": "hall-monitor",
          "sandbox_mode": null,
          "model": "gpt-6-luna",
          "model_reasoning_effort": "high"
        },
        ".claude/agents/orchestrator.md": {
          "model": "opus",
          "effort": "high",
          "tools": "Read, Grep, Glob, Agent(builder, reviewer, hall-monitor), SendMessage"
