    {
      "id": "agent-metadata",
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_metadata": {
        ".claude/agents/builder.md": {
          "name": "builder",
          "tools": "Read, Grep, Glob, Bash, Edit, Write, Skill",
          "skills": "follow-the-rules",
          "model": "sonnet",
          "effort": "high"
        },
        ".claude/agents/reviewer.md": {
          "name": "reviewer",
          "tools": "Read, Grep, Glob, Bash, Skill",
          "skills": null,
          "model": "opus",
          "effort": "high"
        },
        ".claude/agents/hall-monitor.md": {
          "name": "hall-monitor",
          "tools": "Read, Grep, Glob, Bash, Skill",
          "skills": "follow-the-rules",
          "model": "sonnet",
          "effort": "medium"
        },
