          "name": "builder",
          "model": "inherit",
          "readonly": "false"
        },
        ".cursor/agents/reviewer.md": {
          "name": "reviewer",
          "model": "inherit",
          "readonly": "false"
        },
        ".cursor/agents/hall-monitor.md": {
          "name": "hall-monitor",
          "model": "inherit",
          "readonly": "true"
        },
        ".codex/agents/builder.toml": {
          "name": "builder",
          "sandbox_mode": null,
          "model": "gpt-6.1-sol",
          "model_reasoning_effort": "high"
        },
        ".codex/agents/reviewer.toml": {
          "name": "reviewer",
          "sandbox_mode": null,
          "model": "gpt-6.1-sol",
          "model_reasoning_effort": "high"
