{
  "skill_name": "agent-setup",
  "cases": [
    {
      "id": "all-hosts",
      "files": {
        "AGENTS.md": "# Rules\n\nKeep functions small.\n",
        "CLAUDE.md": "# Claude\n\nPrefer short answers.\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_files": [
        ".claude/agents/builder.md",
        ".claude/agents/reviewer.md",
        ".claude/agents/hall-monitor.md",
        ".codex/agents/builder.toml",
        ".codex/agents/reviewer.toml",
        ".codex/agents/hall-monitor.toml",
        ".cursor/agents/builder.md",
        ".cursor/agents/reviewer.md",
        ".cursor/agents/hall-monitor.md"
      ],
      "expect_absent": [
        ".claude/skills/orchestrate/SKILL.md",
        ".agents/skills/orchestrate/SKILL.md",
        ".cursor/skills/orchestrate/SKILL.md"
      ]
    },
    {
      "id": "claude-only",
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "claude"
      ],
      "expect_files": [
        ".claude/agents/builder.md",
        ".claude/agents/reviewer.md",
        ".claude/agents/hall-monitor.md"
      ],
      "expect_absent": [
        ".codex/agents/builder.toml",
        ".codex/agents/reviewer.toml",
        ".codex/agents/hall-monitor.toml",
        ".cursor/agents/builder.md",
        ".cursor/agents/reviewer.md",
        ".cursor/agents/hall-monitor.md",
        ".codex/config.toml",
        ".cursor/rules/orchestrator.mdc"
      ]
    },
    {
      "id": "codex-cursor",
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "codex,cursor"
      ],
      "expect_files": [
        ".codex/agents/builder.toml",
        ".codex/agents/reviewer.toml",
        ".codex/agents/hall-monitor.toml",
        ".cursor/agents/builder.md",
        ".cursor/agents/reviewer.md",
        ".cursor/agents/hall-monitor.md"
      ],
      "expect_absent": [
        ".claude/agents/builder.md",
        ".claude/agents/reviewer.md",
        ".claude/agents/hall-monitor.md",
        ".claude/settings.json"
      ]
    },
    {
      "id": "instruction-files-untouched",
      "files": {
        "AGENTS.md": "# Rules\n\nKeep functions small.\n",
        "CLAUDE.md": "# Claude\n\nPrefer short answers.\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_unchanged": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "id": "agent-metadata",
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_metadata": {
        ".claude/agents/builder.md": {
          "name": "builder",
          "tools": "Read, Grep, Glob, Bash, Edit, Write, Skill",
          "skills": "follow-the-rules"
        },
        ".claude/agents/reviewer.md": {
          "name": "reviewer",
          "tools": "Read, Grep, Glob, Bash, Skill",
          "skills": null
        },
        ".claude/agents/hall-monitor.md": {
          "name": "hall-monitor",
          "tools": "Read, Grep, Glob, Bash, Skill",
          "skills": "follow-the-rules"
        },
        ".cursor/agents/builder.md": {
          "name": "builder",
          "model": "inherit",
          "readonly": "false"
        },
        ".cursor/agents/reviewer.md": {
          "name": "reviewer",
          "model": "inherit",
          "readonly": "false"
        },
        ".cursor/agents/hall-monitor.md": {
          "name": "hall-monitor",
          "model": "inherit",
          "readonly": "true"
        },
        ".codex/agents/builder.toml": {
          "name": "builder",
          "sandbox_mode": "workspace-write"
        },
        ".codex/agents/reviewer.toml": {
          "name": "reviewer",
          "sandbox_mode": "workspace-write"
        },
        ".codex/agents/hall-monitor.toml": {
          "name": "hall-monitor",
          "sandbox_mode": "read-only"
        }
      }
    },
    {
      "id": "no-outside-tools",
      "files": {
        "AGENTS.md": "# Rules\n\nKeep functions small.\n",
        "CLAUDE.md": "# Claude\n\nPrefer short answers.\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_no_match": [
        "serena|gstack|mattpocock|spec kit|\\bnpx\\b"
      ]
    },
    {
      "id": "missing-required",
      "vars": {
        "gate": ""
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_exit": "nonzero",
      "expect_changes": {
        "added": [],
        "removed": [],
        "modified": []
      },
      "expect_output": [
        "gate"
      ]
    },
    {
      "id": "toml-quote",
      "vars": {
        "project": "demo ''' calc"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_exit": "nonzero",
      "expect_changes": {
        "added": [],
        "removed": [],
        "modified": []
      }
    },
    {
      "id": "empty-optional",
      "vars": {
        "gate_scopes": ""
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_no_match": [
        "\\S  +\\S"
      ]
    },
    {
      "id": "foreign-agent",
      "files": {
        ".claude/agents/builder.md": "# my own builder\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_exit": "nonzero",
      "expect_changes": {
        "added": [],
        "removed": [],
        "modified": []
      },
      "expect_output": [
        ".claude/agents/builder.md"
      ]
    },
    {
      "id": "foreign-agent-force",
      "files": {
        ".claude/agents/builder.md": "# my own builder\n"
      },
      "args": [
        "--vars",
        "{vars}",
        "--force"
      ],
      "expect_metadata": {
        ".claude/agents/builder.md": {
          "name": "builder"
        }
      }
    },
    {
      "id": "all-hosts-exact",
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_changes": {
        "added": [
          ".claude/agents/builder.md",
          ".claude/agents/reviewer.md",
          ".claude/agents/hall-monitor.md",
          ".claude/agents/orchestrator.md",
          ".claude/settings.json",
          ".codex/agents/builder.toml",
          ".codex/agents/reviewer.toml",
          ".codex/agents/hall-monitor.toml",
          ".codex/config.toml",
          ".cursor/agents/builder.md",
          ".cursor/agents/reviewer.md",
          ".cursor/agents/hall-monitor.md",
          ".cursor/rules/orchestrator.mdc"
        ],
        "modified": [],
        "removed": []
      }
    },
    {
      "id": "rerun-idempotent",
      "setup": [
        [
          "--vars",
          "{vars}"
        ]
      ],
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_changes": {
        "added": [],
        "removed": [],
        "modified": []
      }
    },
    {
      "id": "claude-entry",
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "claude"
      ],
      "expect_metadata": {
        ".claude/agents/orchestrator.md": {
          "name": "orchestrator",
          "tools": null
        },
        ".claude/settings.json": {
          "agent": "orchestrator"
        }
      },
      "expect_endswith": {
        ".claude/agents/orchestrator.md": "Generated by agent-setup.\n"
      }
    },
    {
      "id": "claude-settings-preserved",
      "files": {
        ".claude/settings.json": "{\"permissions\": {\"allow\": [\"Bash(git status)\"]}}\n"
      },
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "claude"
      ],
      "expect_metadata": {
        ".claude/settings.json": {
          "agent": "orchestrator",
          "permissions": {
            "allow": [
              "Bash(git status)"
            ]
          }
        }
      }
    },
    {
      "id": "claude-settings-foreign",
      "files": {
        ".claude/settings.json": "{\"agent\": \"reviewer-bot\"}\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_exit": "nonzero",
      "expect_changes": {
        "added": [],
        "removed": [],
        "modified": []
      },
      "expect_output": [
        ".claude/settings.json"
      ]
    },
    {
      "id": "codex-entry",
      "files": {
        ".codex/config.toml": "[model_providers.local]\nname = \"local\"\n"
      },
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "codex"
      ],
      "expect_startswith": {
        ".codex/config.toml": "# agent-setup:start\ndeveloper_instructions = '''\n"
      },
      "expect_endswith": {
        ".codex/config.toml": "# agent-setup:end\n\n[model_providers.local]\nname = \"local\"\n"
      },
      "expect_toml": [
        ".codex/config.toml"
      ]
    },
    {
      "id": "codex-foreign",
      "files": {
        ".codex/config.toml": "developer_instructions = 'mine'\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_exit": "nonzero",
      "expect_changes": {
        "added": [],
        "removed": [],
        "modified": []
      },
      "expect_output": [
        ".codex/config.toml"
      ]
    },
    {
      "id": "cursor-entry",
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "cursor"
      ],
      "expect_metadata": {
        ".cursor/rules/orchestrator.mdc": {
          "alwaysApply": "true"
        }
      },
      "expect_endswith": {
        ".cursor/rules/orchestrator.mdc": "Generated by agent-setup.\n"
      }
    },
    {
      "id": "cursor-foreign",
      "files": {
        ".cursor/rules/orchestrator.mdc": "---\nalwaysApply: true\n---\n\nMine.\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_exit": "nonzero",
      "expect_changes": {
        "added": [],
        "removed": [],
        "modified": []
      },
      "expect_output": [
        ".cursor/rules/orchestrator.mdc"
      ]
    },
    {
      "id": "force-replaces-foreign-entry",
      "files": {
        ".claude/settings.json": "{\"agent\": \"reviewer-bot\"}\n",
        ".codex/config.toml": "developer_instructions = 'mine'\n",
        ".cursor/rules/orchestrator.mdc": "Mine.\n"
      },
      "args": [
        "--vars",
        "{vars}",
        "--force"
      ],
      "expect_metadata": {
        ".claude/settings.json": {
          "agent": "orchestrator"
        },
        ".cursor/rules/orchestrator.mdc": {
          "alwaysApply": "true"
        }
      },
      "expect_startswith": {
        ".codex/config.toml": "# agent-setup:start\n"
      },
      "expect_toml": [
        ".codex/config.toml"
      ]
    },
    {
      "id": "codex-force-multiline",
      "files": {
        ".codex/config.toml": "developer_instructions = '''\nmine\nmore\n'''\nmodel = \"local\"\n"
      },
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "codex",
        "--force"
      ],
      "expect_startswith": {
        ".codex/config.toml": "# agent-setup:start\n"
      },
      "expect_endswith": {
        ".codex/config.toml": "# agent-setup:end\n\nmodel = \"local\"\n"
      },
      "expect_toml": [
        ".codex/config.toml"
      ]
    }
  ]
}
