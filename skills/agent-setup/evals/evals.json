{
  "skill_name": "agent-setup",
  "cases": [
    {
      "id": "all-hosts",
      "files": {
        "AGENTS.md": "# Rules\n\nKeep functions small.\n",
        "CLAUDE.md": "# Claude\n\nPrefer short answers.\n"
      },
      "args": [
        "--vars",
        "{vars}"
      ],
      "expect_files": [
        ".claude/agents/builder.md",
        ".claude/agents/reviewer.md",
        ".claude/agents/hall-monitor.md",
        ".codex/agents/builder.toml",
        ".codex/agents/reviewer.toml",
        ".codex/agents/hall-monitor.toml",
        ".cursor/agents/builder.md",
        ".cursor/agents/reviewer.md",
        ".cursor/agents/hall-monitor.md"
      ],
      "expect_absent": [
        ".claude/skills/orchestrate/SKILL.md",
        ".agents/skills/orchestrate/SKILL.md",
        ".cursor/skills/orchestrate/SKILL.md"
      ]
    },
    {
      "id": "claude-only",
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "claude"
      ],
      "expect_files": [
        ".claude/agents/builder.md",
        ".claude/agents/reviewer.md",
        ".claude/agents/hall-monitor.md"
      ],
      "expect_absent": [
        ".codex/agents/builder.toml",
        ".codex/agents/reviewer.toml",
        ".codex/agents/hall-monitor.toml",
        ".cursor/agents/builder.md",
        ".cursor/agents/reviewer.md",
        ".cursor/agents/hall-monitor.md",
        ".codex/config.toml",
        ".cursor/rules/orchestrator.mdc"
      ]
    },
    {
      "id": "codex-cursor",
      "args": [
        "--vars",
        "{vars}",
        "--hosts",
        "codex,cursor"
      ],
      "expect_files": [
        ".codex/agents/builder.toml",
        ".codex/agents/reviewer.toml",
        ".codex/agents/hall-monitor.toml",
        ".cursor/agents/builder.md",
        ".cursor/agents/reviewer.md",
        ".cursor/agents/hall-monitor.md"
      ],
      "expect_absent": [
        ".claude/agents/builder.md",
        ".claude/agents/reviewer.md",
        ".claude/agents/hall-monitor.md",
        ".claude/settings.json"
      ]
    },
