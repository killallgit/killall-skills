#!/usr/bin/env python3
"""
bw-claw — Bitwarden CLI wrapper for programmatic vault access.

Usage:
  bw-claw login                         # interactive login (handles 2FA)
  bw-claw find --name <query>           # search items by name
  bw-claw get  --name <name>            # get password for item
  bw-claw get  --name <name> --field username|password|totp|notes
  bw-claw set  --name <name> --password <value>   # update item password
  bw-claw status                        # vault lock state

Unlock is unattended via BW_MASTER_PW env var (set in ~/.env).
For initial login (first time or after session expiry) use `bw-claw login`.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

BW = "/usr/local/bin/bw"
SESSION_FILE = Path.home() / ".bw-session"


def run(args, capture=True, check=True, env=None):
    merged = {**os.environ, **(env or {})}
    r = subprocess.run(args, capture_output=capture, text=True, env=merged)
    if check and r.returncode != 0:
        msg = r.stderr.strip() or r.stdout.strip()
        print(f"bw error: {msg}", file=sys.stderr)
        sys.exit(1)
    return r


def unlock():
    master_pw = os.environ.get("BW_MASTER_PW")
    if not master_pw:
        print("BW_MASTER_PW not set — check ~/.env is loaded", file=sys.stderr)
        sys.exit(1)
    r = run([BW, "unlock", "--passwordenv", "BW_MASTER_PW", "--raw"])
    session = r.stdout.strip()
    if not session:
        print("Unlock failed — bad master password?", file=sys.stderr)
        sys.exit(1)
    SESSION_FILE.touch(mode=0o600)
    SESSION_FILE.write_text(session)
    SESSION_FILE.chmod(0o600)
    return session


def get_session():
    if SESSION_FILE.exists():
        s = SESSION_FILE.read_text().strip()
        if s:
            return s
    return unlock()


def cleanup():
    if SESSION_FILE.exists():
        SESSION_FILE.unlink()
    run([BW, "lock"], check=False)


def cmd_login():
    """Interactive login — handles email+password+2FA."""
    print("Starting interactive bw login (2FA if enabled)...")
    proc = subprocess.run([BW, "login"])
    if proc.returncode == 0:
        print("Login OK. Run 'bw-claw status' to confirm.")
    else:
        print("Login failed.", file=sys.stderr)
        sys.exit(1)


def cmd_status():
    r = run([BW, "status"], check=False)
    try:
        data = json.loads(r.stdout)
        print(f"status: {data.get('status', 'unknown')}")
        print(f"user:   {data.get('userEmail', 'n/a')}")
    except Exception:
        print(r.stdout.strip() or r.stderr.strip())


def cmd_find(name):
    session = get_session()
    run([BW, "sync", "--session", session], check=False)
    r = run([BW, "list", "items", "--search", name, "--session", session])
    try:
        items = json.loads(r.stdout)
    except Exception:
        print("Failed to parse vault response", file=sys.stderr)
        cleanup()
        sys.exit(1)
    cleanup()
    if not items:
        print(f"No items matching '{name}'")
        return
    for item in items:
        print(f"  [{item.get('id','')}] {item.get('name','')}")


def cmd_get(name, field):
    session = get_session()
    r = run([BW, "get", field, name, "--session", session])
    value = r.stdout.strip()
    cleanup()
    # Print length as proof; pipe value to stdout for programmatic use
    if not value:
        print(f"No {field} found for '{name}'", file=sys.stderr)
        sys.exit(1)
    # Output only to stdout so callers can capture; length confirmation to stderr
    print(f"# retrieved '{name}' {field} ({len(value)} chars)", file=sys.stderr)
    print(value)


def cmd_set(name, password):
    session = get_session()
    run([BW, "sync", "--session", session], check=False)
    # Get item id
    r = run([BW, "list", "items", "--search", name, "--session", session])
    items = json.loads(r.stdout)
    if not items:
        print(f"No item named '{name}'", file=sys.stderr)
        cleanup()
        sys.exit(1)
    if len(items) > 1:
        print(f"Ambiguous — {len(items)} matches for '{name}':", file=sys.stderr)
        for i in items:
            print(f"  [{i['id']}] {i['name']}", file=sys.stderr)
        cleanup()
        sys.exit(1)
    item = items[0]
    item_id = item["id"]
    # Patch password
    if "login" not in item:
        item["login"] = {}
    item["login"]["password"] = password
    enc_proc = subprocess.run(
        [BW, "encode"],
        input=json.dumps(item),
        capture_output=True,
        text=True,
    )
    encoded_str = enc_proc.stdout.strip()
    run([BW, "edit", "item", item_id, encoded_str, "--session", session])
    run([BW, "sync", "--session", session], check=False)
    cleanup()
    print(f"Updated password for '{name}'")


def main():
    parser = argparse.ArgumentParser(prog="bw-claw", description="Bitwarden vault helper")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("login", help="Interactive login (handles 2FA)")
    sub.add_parser("status", help="Vault lock state")

    p_find = sub.add_parser("find", help="Search items by name")
    p_find.add_argument("--name", required=True, help="Search query")

    p_get = sub.add_parser("get", help="Get a vault field")
    p_get.add_argument("--name", required=True, help="Item name (exact or unique prefix)")
    p_get.add_argument("--field", default="password",
                       choices=["password", "username", "totp", "notes", "uri"],
                       help="Field to retrieve (default: password)")

    p_set = sub.add_parser("set", help="Update item password")
    p_set.add_argument("--name", required=True)
    p_set.add_argument("--password", required=True)

    args = parser.parse_args()

    if args.cmd == "login":
        cmd_login()
    elif args.cmd == "status":
        cmd_status()
    elif args.cmd == "find":
        cmd_find(args.name)
    elif args.cmd == "get":
        cmd_get(args.name, args.field)
    elif args.cmd == "set":
        cmd_set(args.name, args.password)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
